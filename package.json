{
  "name": "eric-blanchard-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet -o public/storybook",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "quality": "node scripts/collect-quality.mjs",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm run test:ci && npm run publish-reports && npm run build-storybook && npm run build && npm run e2e && npm run lighthouse && npm run quality && npm run build",
    "publish-reports": "node scripts/publish-reports.mjs",
    "screenshots:capture": "node scripts/screenshots/capture.ts",
    "screenshots:import": "node scripts/screenshots/import.ts"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-storybook": "^10.6.2",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "storybook": "^10.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
